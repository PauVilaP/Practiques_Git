    {
        "id": "p3n0000000000037",
        "type": "function",
        "z": "p3tab0000000001",
        "name": "Historic d'alarmes",
        "func": "// Arriba: tema .../alarma/temp (o .../alarma/hum) i missatge {\"actiu\":true,\"valor\":31.2,\"ts\":...}\n// Cada avís afegeix una fila a la taula:   Hora | Magnitud | Estat | Valor\nconst alarma = msg.payload;\n\n// 1. De quina magnitud és?\nlet magnitud, unitat;\nif (msg.topic.endsWith(\"temp\")) {\n    magnitud = \"Temperatura\";\n    unitat = \" °C\";\n} else {\n    magnitud = \"Humitat\";\n    unitat = \" %\";\n}\n\n// 2. Comença o s'acaba?\nlet estat;\nif (alarma.actiu) estat = \"Inici\";\nelse estat = \"Fi\";\n\n// 3. La fila nova: cada nom (Hora, Magnitud, Estat, Valor) serà una columna de la taula\nconst hora = new Date().toLocaleString(\"ca-ES\", { timeZone: \"Europe/Madrid\" });   // p. ex. \"2/11/2026 18:58:31\"\nconst fila = { Hora: hora, Magnitud: magnitud, Estat: estat, Valor: alarma.valor + unitat };\n\n// 4. Les files d'abans són a la memòria del flux (el primer cop encara no n'hi ha cap)\nlet historic = flow.get(\"historicAlarmes\");\nif (historic === undefined) historic = [];\n\nhistoric.unshift(fila);                      // la nova, a dalt de tot\nif (historic.length > 5) historic.pop();     // màxim 5 files: traiem la més vella (la de baix)\n\nflow.set(\"historicAlarmes\", historic);       // la desem per al pròxim avís\n\n// 5. La taula rep totes les files i les torna a dibuixar\nmsg.payload = historic;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 940,
        "wires": [
            [
                "p3n0000000000038"
            ]
        ]
    },
