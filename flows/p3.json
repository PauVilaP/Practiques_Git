    {
        "id": "p3n0000000000035",
        "type": "function",
        "z": "p3tab0000000001",
        "name": "Text i avis de l'alarma",
        "func": "// Arriba: tema .../alarma/temp (o .../alarma/hum) i missatge {\"actiu\":true,\"valor\":31.2}\nconst alarma = msg.payload;\n\n// 1. De quina magnitud és?\nlet nom, unitat;\nif (msg.topic.endsWith(\"temp\")) {\n    nom = \"temperatura\";\n    unitat = \" °C\";\n} else {\n    nom = \"humitat\";\n    unitat = \" %\";\n}\n\n// 2. Els dos textos: el de l'indicador i el de l'avís\nlet text, avis;\nif (alarma.actiu) {\n    text = \"ALARMA (\" + alarma.valor + unitat + \")\";\n    avis = \"Alarma de \" + nom + \": \" + alarma.valor + unitat;\n} else {\n    text = \"normal\";\n    avis = \"Fi de l'alarma de \" + nom;\n}\n\n// 3. Sortida 1: indicador de temperatura | 2: indicador d'humitat | 3: avís emergent\nif (nom === \"temperatura\") return [{ payload: text }, null, { payload: avis }];\nreturn [null, { payload: text }, { payload: avis }];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 860,
        "wires": [
            [
                "p3n0000000000032"
            ],
            [
                "p3n0000000000033"
            ],
            [
                "p3n0000000000034"
            ]
        ]
    },
