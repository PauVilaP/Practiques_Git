        "z": "p3tab0000000001",
        "name": "Separa per magnitud (pel tema)",
        "func": "// Tema: uvic/se2627/pauvila/<node>/telemetria/<magnitud>\nconst parts = msg.topic.split(\"/\");\nconst nomNode = parts[3];\nconst magnitud = parts[5];\n\nmsg.payload = msg.payload.valor;     // del JSON ens quedem amb el valor\nmsg.topic = nomNode + \" \" + magnitud;   // nom de la serie al grafic\n\nif (magnitud === \"temp\") return [msg, null];\nif (magnitud === \"hum\")  return [null, msg];\nreturn null;",
        "outputs": 2,
