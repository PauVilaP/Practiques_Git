    {
        "id": "p3n0000000000024",
        "type": "function",
        "z": "p3tab0000000001",
        "name": "Ordre de transmissio",
        "func": "// L'estat real del node (el guarda \"Etiqueta del boto\")\nconst estat = flow.get(\"transmissio\") || \"running\";\n\n// Si ara transmet, l'ordre és \"atura\"; si està aturat, \"repren\"\nlet ordre;\nif (estat === \"running\") ordre = \"atura\";\nelse ordre = \"repren\";\n\nmsg.topic = \"uvic/se2627/pauvila/node01/cmd/transmissio\";\nmsg.payload = { id: \"o\" + Date.now(), valor: ordre };\nmsg.retain = false;   // una ordre vella no s'ha de tornar a executar\nmsg.qos = 1;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 540,
        "wires": [
            [
                "p3n0000000000014"
            ]
        ]
    },
    {
        "id": "p3n0000000000025",
        "type": "function",
        "z": "p3tab0000000001",
        "name": "Etiqueta del boto",
        "func": "// Arriba l'estat real del node: \"running\" o \"paused\"\nflow.set(\"transmissio\", msg.payload);   // el guardem perquè \"Ordre de transmissio\" el pugui llegir\n\n// El botó diu el que farà quan el cliquis\nlet text;\nif (msg.payload === \"running\") text = \"Atura transmissio\";\nelse text = \"Repren transmissio\";\nreturn { ui_update: { label: text } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
